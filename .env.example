# OCR API – copy to .env and fill in real values

# ── Authentication ────────────────────────────────────────────────────────────
API_KEY=change-me-to-a-long-random-string

# ── Output: Paperless-ngx ─────────────────────────────────────────────────────
ENABLE_PAPERLESS=true
PAPERLESS_URL=http://192.168.1.100:8000
PAPERLESS_TOKEN=your-paperless-api-token-here

# ── Output: rclone / OneDrive ─────────────────────────────────────────────────
ENABLE_RCLONE=false
RCLONE_TARGET=OneDrive:scanner/
# HOST directory holding rclone.conf, mounted read-write so rclone can save refreshed
# OAuth tokens. Must be writable by the container user (uid 101): chown -R 101:102 <dir>
RCLONE_CONFIG_DIR=./rclone

# ── Output: local filesystem ──────────────────────────────────────────────────
ENABLE_FILESYSTEM=true
OUTPUT_DIR=/ocr-api/output

# ── OCR settings ──────────────────────────────────────────────────────────────
# OCR engine: tesseract (default), paddleocr, openrouter (Tesseract + vision LLM),
# or gcv (Google Cloud Vision stub)
OCR_ENGINE=tesseract
# Language codes – format depends on engine:
#   tesseract:  deu+eng+frk  (Tesseract lang codes, +-separated)
#   paddleocr:  deu+eng+frk  (auto-mapped: deu/frk → german, eng → en)
#   openrouter: deu+eng+frk  (used for the Tesseract text layer; the LLM detects language itself)
#   gcv:        not yet implemented
OCR_LANGUAGE=deu+eng+frk
# PaddleOCR detection input cap (prevents OOM on full-resolution scans).
# Larger side_len = better small-text recall, higher memory (~5 GB per megapixel).
# PADDLE_DET_LIMIT_TYPE=max
# PADDLE_DET_LIMIT_SIDE_LEN=1600
TRASH_TMP_FILES=true

# ── LLM OCR (OCR_ENGINE=openrouter) ───────────────────────────────────────────
# Tesseract still builds the positioned PDF text layer; a vision LLM on OpenRouter
# transcribes each page (much better on handwriting) for the .txt sidecar, AI
# metadata and mail body. Any LLM failure falls back to the Tesseract text.
# Uses OPENROUTER_API_KEY (below). Requests only route to providers that don't
# store or train on prompts (provider.data_collection=deny).
# Cheap model for every page; pages reported as handwritten/uncertain are re-run
# on the strong model (empty = no escalation). Compare models on your own pages:
#   docker compose exec ocr-api python3 -m scripts.compare_ocr_models --help
# OCR_LLM_MODEL=google/gemini-3.1-flash-lite
# OCR_LLM_STRONG_MODEL=google/gemini-3.1-pro-preview
# Outage fallbacks tried by OpenRouter (JSON list):
# OCR_LLM_FALLBACK_MODELS=["openai/gpt-5-mini"]
# OCR_LLM_CONCURRENCY=3
# OCR_LLM_TIMEOUT=90
# Output token budgets; reasoning tokens count toward them. The cheap pass is kept
# small so a repetition loop fails fast and escalates; the strong/line+box call needs
# up to ~6.2k tokens on dense table pages:
# OCR_LLM_MAX_TOKENS=3000
# OCR_LLM_STRONG_MAX_TOKENS=8000
# Reasoning effort per tier: empty = provider default, or none|minimal|low|medium|high.
# Reasoning models think a lot at their default (slow, can truncate the transcript).
# OCR_LLM_REASONING_EFFORT=
# OCR_LLM_STRONG_REASONING_EFFORT=
# LLM text in the PDF text layer (Ctrl+F and Paperless full-text search):
#   off        - Tesseract layer only (default)
#   block      - plus the LLM transcript as an invisible, unpositioned block per page
#   positioned - handwritten/escalated pages: the strong model returns lines with
#                bounding boxes that replace Tesseract's text on that page (search
#                hits land on the handwriting); falls back to block, then Tesseract
# OCR_LLM_PDF_TEXT=off
# OCR_LLM_IMAGE_MAX_SIDE=2000
# Escalate when the transcript contains more than this many [?] markers:
# OCR_LLM_ESCALATE_UNCLEAR_MAX=2

# ── AI Metadata extraction (OpenRouter) ───────────────────────────────────────
# When enabled, the OCR text is sent to an LLM to extract topic, correspondent,
# document type, and tags. The result renames the output file and pre-fills
# the structured fields in Paperless-ngx.
ENABLE_AI_METADATA=false
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
# Model to use – see https://openrouter.ai/models for options
# claude-haiku-4.5 is fast and cheap; upgrade to claude-sonnet-4.5 for more accuracy
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Primary language of your documents (de = German, en = English)
AI_DOCUMENT_LANGUAGE=de

# ── Email notification (mutt + msmtp inside container) ────────────────────────
ENABLE_MAIL=false
MAIL_TO=recipient@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASSWORD=your-smtp-password
# SMTP_FROM defaults to SMTP_USER if left empty
SMTP_FROM=ocr-scanner@example.com
